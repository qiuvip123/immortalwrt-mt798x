#!/bin/sh
# A31 v2 定制默认配置: LAN 192.168.2.1 / argon 主题 / 中文 LuCI / WiFi 开放(无密码)
uci -q batch <<'EOF'
set network.lan.ipaddr='192.168.2.1'
set network.lan.netmask='255.255.255.0'
commit network
set luci.main.mediaurlbase='/luci-static/argon'
set luci.main.lang='zh_cn'
set luci.languages.zh_cn='Chinese'
commit luci
EOF

# WiFi 开放(清空所有加密/密钥, 若 wireless 配置已生成)
for _s in $(uci -q show wireless 2>/dev/null | sed -n "s/^wireless\.\([a-zA-Z0-9_]*\)\.encryption=.*/\1/p" | sort -u); do
	uci -q set "wireless.$_s.encryption=none"
	uci -q delete "wireless.$_s.key"
	uci -q delete "wireless.$_s.sae_password"
	uci -q delete "wireless.$_s.sae"
done
uci -q commit wireless 2>/dev/null

# 让新 LAN IP 立即生效
[ -x /etc/init.d/network ] && /etc/init.d/network restart >/dev/null 2>&1 || true
exit 0
